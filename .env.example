# -----------------------------------------------------------------------------
# Base de datos: Neon, proyecto propio (NO el de Control-Secaderos)
# -----------------------------------------------------------------------------
#
# Las dos cadenas salen del boton "Connect" del proyecto en console.neon.tech.
#
# DATABASE_URL  -> la POOLED. El host lleva "-pooler" en el medio.
#                  Es la que usa la app en runtime: en serverless cada instancia
#                  abre su propia conexion, y el pooler de Neon es lo que evita
#                  que se agote el cupo.
#
# DIRECT_URL    -> la DIRECTA, sin "-pooler".
#                  Solo para drizzle-kit (push, generate, studio). Las
#                  migraciones necesitan una sesion real, no una conexion
#                  pooleada.
#
# Las dos terminan en ?sslmode=require. No se lo saques.
DATABASE_URL="postgresql://USUARIO:PASSWORD@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:PASSWORD@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Sesion
# -----------------------------------------------------------------------------
# Clave para firmar las cookies. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-por-una-clave-larga-y-aleatoria"

# PIN inicial del usuario admin que crea el seed (usuario: admin).
# Cambialo desde el panel apenas entres la primera vez.
ADMIN_PIN="1234"
